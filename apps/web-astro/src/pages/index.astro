---
import BaseLayout from '@layouts/BaseLayout.astro';
import { festivalRepository } from '@lib/festivals';
import { t } from '@lib/i18n/t';
import { canonicalFor } from '@lib/seo/urls';

export const prerender = true;

const baseUrl = (Astro.site?.origin ?? import.meta.env.PUBLIC_BASE_URL ?? 'http://localhost:4321').replace(
  /\/$/,
  '',
);
const slugs = await festivalRepository.listSlugs();
const entries = (
  await Promise.all(slugs.map((slug) => festivalRepository.getBySlug(slug)))
).filter((entry): entry is NonNullable<typeof entry> => entry !== null);

const title = 'TuriaFest — Guía de festivales de la Comunitat Valenciana';
const description = t('home.hero.description');
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalFor('/', baseUrl)}
>
  <section class="poc-home" data-testid="poc-home">
    <h1>TuriaFest</h1>
    <p>{description}</p>
    <p class="poc-home__note">
      PoC Astro — vertical slice en
      <code>/festivales/:slug</code>. Angular sigue en producción.
    </p>
    <ul class="poc-home__list">
      {
        entries.map((entry) => (
          <li>
            <a href={`/festivales/${entry.slug}`}>{entry.nombre}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style lang="scss">
  .poc-home {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--fv-space-7) var(--fv-space-4);
    display: grid;
    gap: var(--fv-space-4);
    color: var(--fv-text-nav);
    font-family: var(--fv-font-ui);

    h1 {
      margin: 0;
      font-family: var(--fv-font-heading);
      font-size: clamp(2rem, 6vw, 3rem);
    }

    p {
      margin: 0;
      color: var(--fv-text-footer-muted);
      line-height: var(--fv-leading-relaxed);
    }
  }

  .poc-home__note {
    font-size: var(--fv-text-sm);
    padding: var(--fv-space-3);
    border-radius: var(--fv-radius-md);
    border: 1px solid var(--fv-border-nav);
    background: var(--fv-bg-card-light);
  }

  .poc-home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--fv-space-2);

    a {
      color: var(--fv-text-nav);
      font-weight: 600;
      text-decoration: none;
      min-height: 44px;
      display: inline-flex;
      align-items: center;

      &:focus-visible {
        outline: none;
        box-shadow: var(--fv-shadow-focus);
        border-radius: var(--fv-radius-sm);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      a:hover {
        text-decoration: underline;
      }
    }
  }
</style>
