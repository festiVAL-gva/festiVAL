# Absolute site origin used for canonicals, Open Graph and sitemap. No trailing slash.
PUBLIC_BASE_URL=http://localhost:4321

# Sanity (wired later via the repository adapter — leave empty for the JSON PoC).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=development
PUBLIC_SANITY_API_VERSION=2024-01-01
PUBLIC_SANITY_USE_CDN=false
