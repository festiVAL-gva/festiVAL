---
import type { FestivalDetailEntry } from '@lib/festivals/catalogue';
import { t } from '@lib/i18n/t';

interface Props {
  entry: FestivalDetailEntry;
}

const { entry } = Astro.props;
const e = entry;
---

<article class="festival-hero" data-testid="festival-hero">
  <div class="festival-hero__content">
    <nav class="festival-hero__breadcrumb" aria-label={t('festival.detail.hero.breadcrumb.ariaLabel')}>
      <a href="/" class="festival-hero__bc-link">{t('festival.detail.hero.breadcrumb.home')}</a>
      <span class="festival-hero__bc-sep" aria-hidden="true">/</span>
      <a href="/festivales" class="festival-hero__bc-link">{t('festival.detail.hero.breadcrumb.festivals')}</a>
      <span class="festival-hero__bc-sep" aria-hidden="true">/</span>
      <span class="festival-hero__bc-current" aria-current="page">{t(e.hero.breadcrumbCurrentKey)}</span>
    </nav>

    <div class="festival-hero__title-block">
      <h1 class="festival-hero__title-main">{t(e.hero.titleKey)}</h1>
      <p class="festival-hero__title-sub" aria-hidden="true">{t(e.hero.subtitleKey)}</p>
    </div>

    <ul class="festival-hero__meta" aria-label={t('festival.detail.hero.meta.ariaLabel')}>
      <li class="festival-hero__meta-item">
        <span>{t(e.hero.locationKey)}</span>
      </li>
      <li class="festival-hero__meta-item">
        <time datetime={e.hero.datetime}>{t(e.hero.datesKey)}</time>
      </li>
    </ul>

    <div class="festival-hero__ctas">
      <a
        href={e.hero.ticketUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="festival-hero__cta festival-hero__cta--primary"
      >
        {t('festival.detail.hero.cta.tickets')}
      </a>
      <a
        href={e.hero.officialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="festival-hero__cta festival-hero__cta--secondary"
      >
        {t('festival.detail.hero.cta.official')}
      </a>
    </div>
  </div>

  <div class="festival-hero__img-wrap" aria-hidden="true">
    <img
      class:list={['festival-hero__image', e.hero.poster.fit === 'contain' && 'festival-hero__image--contain']}
      src={e.hero.poster.src}
      alt=""
      width={e.hero.poster.width}
      height={e.hero.poster.height}
      fetchpriority="high"
      decoding="async"
    />
    <div class="festival-hero__img-fade"></div>
  </div>
</article>

<style lang="scss">
  @use 'styles/breakpoints' as *;

  .festival-hero {
    display: flex;
    flex-direction: column;

    @include from(lg) {
      flex-direction: row;
      min-height: 380px;
    }
  }

  .festival-hero__content {
    flex: 0 0 auto;
    padding: var(--fv-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--fv-space-3);

    @include from(lg) {
      flex: 0 0 42%;
      padding: var(--fv-space-6);
      justify-content: center;
    }
  }

  .festival-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--fv-space-1);
    font-family: var(--fv-font-ui);
    font-size: var(--fv-text-xs);
    color: var(--fv-text-footer-muted);
    flex-wrap: wrap;
  }

  .festival-hero__bc-link {
    color: inherit;
    text-decoration: none;

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--fv-text-nav);
        text-decoration: underline;
      }
    }
  }

  .festival-hero__bc-current {
    color: var(--fv-text-nav);
    font-weight: 600;
  }

  .festival-hero__bc-sep {
    opacity: 0.5;
  }

  .festival-hero__title-block {
    display: flex;
    flex-direction: column;
    margin: var(--fv-space-1) 0;
  }

  .festival-hero__title-main,
  .festival-hero__title-sub {
    font-family: var(--fv-font-heading);
    font-size: clamp(34px, 10.5vw, 84px);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: var(--fv-tracking-tight);
    color: var(--fv-text-nav);
    margin: 0;
  }

  .festival-hero__title-sub {
    letter-spacing: 0.1em;

    @include from(lg) {
      letter-spacing: 0.18em;
    }
  }

  .festival-hero__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--fv-space-2);
  }

  .festival-hero__meta-item {
    font-family: var(--fv-font-ui);
    font-size: var(--fv-text-sm);
    color: var(--fv-text-footer-muted);
  }

  .festival-hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--fv-space-3);
    flex-wrap: wrap;
    margin-top: var(--fv-space-1);
  }

  .festival-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--fv-space-2);
    border-radius: var(--fv-radius-pill);
    font-family: var(--fv-font-ui);
    font-size: var(--fv-text-sm);
    font-weight: 700;
    letter-spacing: var(--fv-tracking-wide);
    text-decoration: none;
    padding: var(--fv-space-3) var(--fv-space-5);
    white-space: nowrap;
    min-height: 44px;

    &:focus-visible {
      outline: none;
      box-shadow: var(--fv-shadow-focus);
    }
  }

  .festival-hero__cta--primary {
    background: var(--fv-text-nav);
    color: var(--fv-bg-page);
    box-shadow: var(--fv-shadow-hero-btn-primary);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        opacity: 0.88;
      }
    }
  }

  .festival-hero__cta--secondary {
    background: transparent;
    color: var(--fv-text-nav);
    border: 1.5px solid var(--fv-border-nav);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        background: var(--fv-bg-nav-icon-hover);
      }
    }
  }

  .festival-hero__img-wrap {
    position: relative;
    flex: 1 1 auto;
    min-height: 240px;
    overflow: hidden;
    background: var(--fv-bg-image-matte);

    @include from(lg) {
      min-height: unset;
    }

    img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  }

  .festival-hero__image--contain {
    object-fit: contain !important;
    object-position: center !important;
  }

  .festival-hero__img-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, var(--fv-bg-page) 0%, transparent 22%);

    @include from(lg) {
      background: linear-gradient(to right, var(--fv-bg-page) 0%, transparent 18%);
    }
  }
</style>
